# =========================
# SERVER CONFIG
# =========================
PORT=3000
APP_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:8081

# =========================
# DATABASE
# =========================
DB_HOST=postgres
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=postgres
DB_NAME=my_backend_db

# Prisma connection string
DATABASE_URL=postgresql://myuser:postgres@localhost:5432/my_backend_db

# =========================
# AUTHENTICATION
# =========================
JWT_SECRET=your_jwt_secret_here

# =========================
# AWS (OPTIONAL - FILE STORAGE)
# =========================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=your_bucket_name

# =========================
# AI / LLM CONFIG
# =========================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Prevents rate limiting for embeddings
GEMINI_EMBEDDING_MIN_INTERVAL_MS=900

# Vector DB (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_index_name
PINECONE_HOST=your_pinecone_host

# =========================
# EXTERNAL APIs
# =========================
OPENWEATHERMAP_API_KEY=your_openweathermap_key
SERPAPI_API_KEY=your_serpapi_key

# =========================
# GOOGLE AUTH
# =========================
# Comma-separated list of valid OAuth audiences
GOOGLE_AUTH_CLIENT_IDS=your_google_client_ids

GOOGLE_WEB_CLIENT_ID=your_web_client_id
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id
GOOGLE_IOS_CLIENT_ID=your_ios_client_id

# =========================
# CLIENT (EXPO PUBLIC VARS)
# =========================
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id