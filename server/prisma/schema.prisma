// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id])
  profiles  Profile[]
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([roleId])
}

model Profile {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  first_name    String
  last_name     String
  age           String?
  profile_image String?
  main_profile  Boolean   @default(true)
  isComplete    Boolean   @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  conditions Condition[]
  allergens Allergen[]
  preferences Preference[]
  @@index([userId])
}

model Condition {
  id            String   @id @default(uuid())
  name          String
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profiles      Profile[]
}

model Allergen {
  id            String   @id @default(uuid())
  name          String
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profiles      Profile[]
}
model Preference {
  id            String   @id @default(uuid())
  name          String
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profiles      Profile[]
}

model Prompt {
  id            Int @id @default(autoincrement())
  prompt_text   String
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}